# ------------------------------------------------------------------
# RUN STITCHCODE — files Git should never track
# ------------------------------------------------------------------

# Dependencies — everyone installs these with `npm install`
node_modules/

# Build output — produced by `npm run build`
dist/
dist-ssr/
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor & OS clutter
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Environment secrets — never share these
.env
.env.local
.env.*.local

# Test & coverage output
coverage/
*.tsbuildinfo
.next/
build/
